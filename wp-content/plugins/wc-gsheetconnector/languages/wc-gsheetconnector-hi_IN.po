msgstr "त्रुटि लॉग"

msgid "Error logs are saved in the database. Please clear them regularly to avoid increasing the database size."
msgstr "त्रुटि लॉग डेटाबेस में सहेजे गए हैं। कृपया उन्हें नियमित रूप से साफ करें ताकि डेटाबेस का आकार न बढ़े।"

msgid "Clear Logs"
msgstr "लॉग साफ करें"

msgid "Download CSV"
msgstr "CSV डाउनलोड करें"

msgid "Copy Logs"
msgstr "लॉग कॉपी करें"

msgid "Date"
msgstr "तारीख"

msgid "Error ID"
msgstr "त्रुटि आईडी"


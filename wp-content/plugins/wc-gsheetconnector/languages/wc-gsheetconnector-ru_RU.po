msgstr "Включить бета-обновления"

msgid ""
"Receive notifications and access to beta releases. Updates will not be installed "
"automatically."
msgstr ""
"Получайте уведомления и доступ к бета-релизам. Обновления не будут устанавливаться "
"автоматически."

msgid "Beta Usage Notice"
msgstr "Уведомление о бета-версии"

msgid "Beta versions may include unfinished or experimental features"
msgstr "Бета-версии могут содержать незавершенные или экспериментальные функции"

msgid "Some features may change or be removed in future updates"
msgstr "Некоторые функции могут измениться или быть удалены в будущих обновлениях"


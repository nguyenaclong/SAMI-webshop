msgstr ""
"Аутентифицируйтесь напрямую с Google, используя безопасный процесс аутентификации "
"без зависимости от третьих сторон."

msgid "Advanced Configuration"
msgstr "Расширенная конфигурация"

msgid ""
"Set custom Redirect URIs, manage scopes, and configure API settings based on your "

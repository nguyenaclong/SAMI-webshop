msgstr "Cuenta de Servicio (Recomendado)"

msgid "Google Account Connection"
msgstr "Conexión de Cuenta de Google"

msgid "Auto Setup"
msgstr "Configuración automática"

msgid ""
"Sign in with your Google account to connect WooCommerce with Google Sheets. Once "
"connected, your data syncs based on your settings. Learn more in the "
"documentation"
msgstr ""
"Inicie sesión con su cuenta de Google para conectar WooCommerce con Google "
"Sheets. Una vez conectado, sus datos se sincronizan según su configuración. "
"Aprenda más en la documentación."

msgid "Click here"
msgstr "Haz clic aquí"

msgid "Click on the <strong>Sign in with Google</strong> button."
msgstr "Haga clic en el botón <strong>Iniciar sesión con Google</strong>."

msgid "Log in using your Google account."
msgstr "Inicie sesión utilizando su cuenta de Google."

msgid "Select the Google account where your Sheets are stored."
msgstr "Seleccione la cuenta de Google donde se almacenan sus hojas."

msgid "Grant access to:"
msgstr "Conceder acceso a:"

msgid "Google Drive"
msgstr "Google Drive"

msgid "Google Sheets"
msgstr "Google Sheets"

msgid "Click <strong>Allow</strong> to finish authorization."
msgstr "Haga clic en <strong>Permitir</strong> para finalizar la autorización."

msgid "Save the authentication code if prompted."
msgstr "Guarde el código de autenticación si se le solicita."

msgid "This allows the plugin to securely sync your form data with Google Sheets."
msgstr ""
"Esto permite que el plugin sincronice de forma segura los datos de su formulario "
"con Google Sheets."

msgid ""
"<p class=\"fw-400 text-dark\"><strong>Google Drive</strong> and <strong>Google "
"Sheets</strong> permissions were not granted during authentication with Google.</"
"p>\n"
"                  <p class=\"fw-400 text-dark\"><strong>Refer to Step 4 in the "
"Connection Guide shown alongside.</strong><br> Then, deactivate the connection "
"and re-authorize it, ensuring both Google Drive and Google Sheets permissions "
"are enabled.</p>"
msgstr ""
"<p class=\"fw-400 text-dark\"><strong>Google Drive</strong> y los permisos de "
"<strong>Google Sheets</strong> no se concedieron durante la autenticación con "
"Google.</p>\n"
"                  <p class=\"fw-400 text-dark\"><strong>Consulta el paso 4 de la "
"guía de conexión mostrada al lado.</strong><br> Después, desactiva la conexión y "
"vuelve a autorizarla, asegurándote de que los permisos de Google Drive y Google "
"Sheets estén habilitados.</p>"

msgid "Connected Google Account"

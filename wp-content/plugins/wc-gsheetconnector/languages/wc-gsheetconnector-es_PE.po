msgid ""
"Sign in with your Google account to connect WooCommerce with Google Sheets. Once "
"connected, your data syncs based on your settings. Learn more in the documentation"
msgstr ""
"Inicia sesión con tu cuenta de Google para conectar WooCommerce con Google Sheets. "
"Una vez conectado, tus datos se sincronizan según tu configuración. Obtén más "
"información en la documentación"

msgid "Click here"
msgstr "Haz clic aquí"

msgid "Click on the <strong>Sign in with Google</strong> button."
msgstr "Haz clic en el botón <strong>Iniciar sesión con Google</strong>."

msgid "Log in using your Google account."
msgstr "Inicia sesión usando tu cuenta de Google."

msgid "Select the Google account where your Sheets are stored."
msgstr "Selecciona la cuenta de Google donde están almacenadas tus Sheets."

msgid "Grant access to:"
msgstr "Conceder acceso a:"

msgid "Google Drive"
msgstr "Google Drive"

msgid "Google Sheets"
msgstr "Google Sheets"

msgid "Click <strong>Allow</strong> to finish authorization."
msgstr "Haz clic en <strong>Permitir</strong> para finalizar la autorización."

msgid "Save the authentication code if prompted."
msgstr "Guarda el código de autenticación si se solicita."

msgid "This allows the plugin to securely sync your form data with Google Sheets."
msgstr ""
"Esto permite que el plugin sincronice de forma segura los datos de tu formulario "
"con Google Sheets."

msgid ""
"<p class=\"fw-400 text-dark\"><strong>Google Drive</strong> and <strong>Google "
"Sheets</strong> permissions were not granted during authentication with Google.</"
"p>\n"
"                  <p class=\"fw-400 text-dark\"><strong>Refer to Step 4 in the "
"Connection Guide shown alongside.</strong><br> Then, deactivate the connection and "
"re-authorize it, ensuring both Google Drive and Google Sheets permissions are "
"enabled.</p>"
msgstr ""
"<p class=\"fw-400 text-dark\"><strong>Google Drive</strong> y <strong>Google "
"Sheets</strong> permisos no fueron otorgados durante la autenticación con Google.</"
"p>\n"
"                  <p class=\"fw-400 text-dark\"><strong>Consulta el paso 4 de la "
"Guía de conexión que se muestra al lado.</strong><br> Luego, desactiva la conexión "
"y vuelve a autorizarla, asegurándote de que los permisos de Google Drive y Google "
"Sheets estén habilitados.</p>"


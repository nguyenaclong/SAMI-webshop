msgstr "Google 账户连接"

msgid "Auto Setup"
msgstr "自动设置"

msgid ""
"Sign in with your Google account to connect WooCommerce with Google Sheets. Once "
"connected, your data syncs based on your settings. Learn more in the documentation"
msgstr ""
"使用您的 Google 账户登录以将 WooCommerce 连接到 Google 表格。连接后，您的数据将根"
"据您的设置进行同步。详细信息请参阅文档。"

msgid "Click here"
msgstr "点击这里"

msgid "Click on the <strong>Sign in with Google</strong> button."
msgstr "点击 <strong>使用 Google 登录</strong> 按钮。"

msgid "Log in using your Google account."
msgstr "使用您的 Google 帐户登录。"

msgid "Select the Google account where your Sheets are stored."
msgstr "选择存储您的表格的 Google 帐户。"

msgid "Grant access to:"
msgstr "授予访问权限："

msgid "Google Drive"
msgstr "Google Drive"

msgid "Google Sheets"
msgstr "Google 表格"

msgid "Click <strong>Allow</strong> to finish authorization."
msgstr "点击 <strong>允许</strong> 完成授权。"

msgid "Save the authentication code if prompted."
msgstr "如果提示，请保存身份验证代码。"

msgid "This allows the plugin to securely sync your form data with Google Sheets."
msgstr "这允许插件安全地将您的表单数据与 Google Sheets 同步。"

msgid ""
"<p class=\"fw-400 text-dark\"><strong>Google Drive</strong> and <strong>Google "
"Sheets</strong> permissions were not granted during authentication with Google.</"
"p>\n"
"                  <p class=\"fw-400 text-dark\"><strong>Refer to Step 4 in the "
"Connection Guide shown alongside.</strong><br> Then, deactivate the connection "
"and re-authorize it, ensuring both Google Drive and Google Sheets permissions are "
"enabled.</p>"
msgstr ""
"<p class=\"fw-400 text-dark\"><strong>Google Drive</strong> 和 <strong>Google "
"Sheets</strong> 权限在通过 Google 进行身份验证时未被授予。</p>\n"
"                  <p class=\"fw-400 text-dark\"><strong>请参阅旁边连接指南中的第 "
"4 步。</strong><br> 然后，停用该连接并重新授权，确保已启用 Google Drive 和 Google "

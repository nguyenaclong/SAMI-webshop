msgstr "Accorder l'accès à :"

msgid "Google Drive"
msgstr "Google Drive"

msgid "Google Sheets"
msgstr "Google Sheets"

msgid "Click <strong>Allow</strong> to finish authorization."
msgstr "Cliquez sur <strong>Autoriser</strong> pour terminer l'autorisation."

msgid "Save the authentication code if prompted."
msgstr "Enregistrez le code d'authentification si cela vous est demandé."

msgid "This allows the plugin to securely sync your form data with Google Sheets."
msgstr ""
"Cela permet au plugin de synchroniser en toute sécurité vos données de formulaire "
"avec Google Sheets."

msgid ""
"<p class=\"fw-400 text-dark\"><strong>Google Drive</strong> and <strong>Google "
"Sheets</strong> permissions were not granted during authentication with Google.</"
"p>\n"
"                  <p class=\"fw-400 text-dark\"><strong>Refer to Step 4 in the "
"Connection Guide shown alongside.</strong><br> Then, deactivate the connection "
"and re-authorize it, ensuring both Google Drive and Google Sheets permissions are "
"enabled.</p>"
msgstr ""
"<p class=\"fw-400 text-dark\"><strong>Google Drive</strong> et les autorisations "
"<strong>Google Sheets</strong> n’ont pas été accordées lors de l’authentification "
"avec Google.</p>\n"
"                  <p class=\"fw-400 text-dark\"><strong>Référez-vous à l’étape 4 "
"du guide de connexion affiché ci-contre.</strong><br> Ensuite, désactivez la "
"connexion et réautorisez-la, en vous assurant que les autorisations Google Drive "
"et Google Sheets sont bien activées.</p>"


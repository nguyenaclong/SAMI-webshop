msgid ""
"Sign in with your Google account to connect WooCommerce with Google Sheets. Once "
"connected, your data syncs based on your settings. Learn more in the documentation"
msgstr ""
"Connectez-vous avec votre compte Google pour relier WooCommerce à Google Sheets. "
"Une fois connecté, vos données se synchronisent en fonction de vos paramètres. En "
"savoir plus dans la documentation"

msgid "Click here"
msgstr "Cliquez ici"

msgid "Click on the <strong>Sign in with Google</strong> button."
msgstr "Cliquez sur le bouton <strong>Se connecter avec Google</strong>."

msgid "Log in using your Google account."
msgstr "Connectez-vous en utilisant votre compte Google."

msgid "Select the Google account where your Sheets are stored."
msgstr "Sélectionnez le compte Google où vos feuilles sont stockées."


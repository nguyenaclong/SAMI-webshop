msgid ""
"Authentication failed. Your Google access token may be expired or invalid. Please "
"re-authenticate your account with the required permissions."
msgstr ""
"Authenticatie mislukt. Je Google-toegangstoken is mogelijk verlopen of ongeldig. "
"Gelieve je account opnieuw te authenticeren met de vereiste machtigingen."

msgid "Connect Your Google Account"
msgstr "Verbind uw Google-account"

msgid ""
"Securely link your Google account to start syncing form entries automatically."
msgstr ""
"Koppel uw Google-account veilig om automatisch formulierinvoer te synchroniseren."

msgid "Sign in with Google"
msgstr "Aanmelden met Google"

msgid "Client Token"
msgstr "Clienttoken"

msgid "Save Client Token"
msgstr "Sla Client Token Op"

msgid ""

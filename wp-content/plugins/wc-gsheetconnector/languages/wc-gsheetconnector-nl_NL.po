msgstr "Kopinstellingen"

msgid ""
"Customize the appearance and behavior of your sheet headers and rows for better "
"readability and organization."
msgstr ""
"Pas het uiterlijk en gedrag van uw bladkoppen en rijen aan voor betere "
"leesbaarheid en organisatie."

msgid "Header Behavior"
msgstr "Kopgedrag"

msgid "Freeze Header"
msgstr "Kop vastzetten"


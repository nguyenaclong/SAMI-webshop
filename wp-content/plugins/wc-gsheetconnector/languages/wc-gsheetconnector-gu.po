msgstr "સેવા ખાતું (સૂચવાયું)"

msgid "Google Account Connection"
msgstr "Google ખાતા કનેક્શન"

msgid "Auto Setup"
msgstr "ઓટો સેટઅપ"

msgid ""
"Sign in with your Google account to connect WooCommerce with Google Sheets. Once connected, your data syncs based on your "
"settings. Learn more in the documentation"
msgstr ""
"તમારા Google એકાઉન્ટથી સાઇન ઇન કરીને WooCommerce ને Google Sheets સાથે કનેક્ટ કરો. એકવાર કનેક્ટ થઈ જાય પછી, તમારો ડેટા તમારી સેટિંગ્સ પ્રમાણે "
"સિંક થશે. વધુ માહિતી માટે ડોક્યુમેન્ટેશન જુઓ"

msgid "Click here"
msgstr "અહીં ક્લિક કરો"

msgid "Click on the <strong>Sign in with Google</strong> button."
msgstr "<strong>Google સાથે સાઇન ઇન</strong> બટન પર ક્લિક કરો."

msgid "Log in using your Google account."
msgstr "તમારા Google ખાતાનો ઉપયોગ કરીને લોગ ઇન કરો."

msgid "Select the Google account where your Sheets are stored."
msgstr "તે Google ખાતા પસંદ કરો જ્યાં તમારી Sheets સંગ્રહિત છે."

msgid "Grant access to:"
msgstr "પ્રવેશ પરવાનગી આપો:"

msgid "Google Drive"
msgstr "ગૂગલ ડ્રાઇવ"

msgid "Google Sheets"
msgstr "ગૂગલ શીટ્સ"

msgid "Click <strong>Allow</strong> to finish authorization."
msgstr "પ્રમાણિકરણ પૂર્ણ કરવા માટે <strong>આગે વધો</strong> પર ક્લિક કરો."

msgid "Save the authentication code if prompted."
msgstr "જો સૂચવવામાં આવે તો પ્રમાણિકરણ કોડ સાચવો."

msgid "This allows the plugin to securely sync your form data with Google Sheets."
msgstr "આ પ્લગિનને તમારા ફોર્મ ડેટાને Google Sheets સાથે સુરક્ષિત રીતે સમન્વયિત કરવાની મંજૂરી આપે છે."

msgid ""
"<p class=\"fw-400 text-dark\"><strong>Google Drive</strong> and <strong>Google Sheets</strong> permissions were not granted "
"during authentication with Google.</p>\n"
"                  <p class=\"fw-400 text-dark\"><strong>Refer to Step 4 in the Connection Guide shown alongside.</strong><br> "
"Then, deactivate the connection and re-authorize it, ensuring both Google Drive and Google Sheets permissions are enabled.</p>"
msgstr ""
"<p class=\"fw-400 text-dark\"><strong>Google Drive</strong> અને <strong>Google Sheets</strong> માટેની પરવાનગીઓ Google સાથેની "
"ઓથેન્ટિકેશન દરમિયાન આપવામાં આવી નહોતી.</p>\n"
"                  <p class=\"fw-400 text-dark\"><strong>આસપાસ દર્શાવેલા કનેક્શન માર્ગદર્શિકામાં Step 4 જુઓ.</strong><br> ત્યારબાદ, કનેક્શનને "
"નિષ્ક્રિય કરો અને ફરીથી ઓથોરાઈઝ કરો, ખાતરી કરો કે Google Drive અને Google Sheets બંને પરવાનગીઓ સક્રિય છે.</p>"

msgid "Connected Google Account"
msgstr "જોડાયેલ Google ખાતું"

msgid "Connected"
msgstr "જોડાયેલ"

msgid ""
"Authentication failed. Your Google access token may be expired or invalid. Please re-authenticate your account with the required "
"permissions."
msgstr ""
"ઓથેન્ટિકેશન નિષ્ફળ થયું. તમારો Google ઍક્સેસ ટોકન કદાચ સમાપ્ત થઈ ગયો છે અથવા અમાન્ય છે. કૃપા કરીને જરૂરી પરવાનગીઓ સાથે તમારા એકાઉન્ટને ફરીથી "
"ઓથેન્ટિકેટ કરો."

msgid "Connect Your Google Account"
msgstr "તમારો ગૂગલ એકાઉન્ટ કનેક્ટ કરો"

msgid "Securely link your Google account to start syncing form entries automatically."
msgstr "ફોર્મ એન્ટ્રીઓને આપમેળે સમંકલન કરવા માટે તમારા ગૂગલ એકાઉન્ટને સુરક્ષિત રીતે લિંક કરો."

msgid "Sign in with Google"
msgstr "Google સાથે સાઇન ઇન કરો"

msgid "Client Token"
msgstr "ક્લાયન્ટ ટોકન"

msgid "Save Client Token"
msgstr "ક્લાયન્ટ ટોકન સાચવો"

msgid ""
"We do not store any of the data from your Google account on our servers, everything is processed & stored on your server. We take "
"your privacy extremely seriously and ensure it is never misused. Learn more in the documentation"
msgstr ""
"અમે તમારા ગૂગલ એકાઉન્ટમાંથી કોઈપણ ડેટા અમારી સર્વર્સ પર સંગ્રહિત નથી કરતા, બધું તમારા સર્વર પર પ્રક્રિયા અને સંગ્રહિત થાય છે. અમે તમારી ગોપનીયતા ખૂબ "
"જ ગંભીરતાથી લેતા છીએ અને ખાતરી કરીએ છીએ કે તેનો ક્યારેય દુરૂપયોગ ન થાય. દસ્તાવેજોમાં વધુ જાણો"

msgid "click here."
msgstr "અહીં ક્લિક કરો."

msgid "Connection Status & Next Steps"
msgstr "કનેક્શન સ્થિતિ & આગામી પગલાં"

msgid ""
"Your Google account has been successfully connected. You are now ready to sync your WooCommerce data with Google Sheets securely "
"and automatically."
msgstr ""
"તમારો Google ખાતો સફળતાપૂર્વક જોડાયો છે. તમે હવે તમારા WooCommerce ડેટાને Google Sheets સાથે સુરક્ષિત અને સ્વચાલિત રીતે સમન્વયિત કરવા માટે તૈયાર "
"છો."

msgid "Create New Feed"
msgstr "નવું ફીડ બનાવો"

msgid "Select Google Spreadsheet"
msgstr "ગૂગલ સ્પ્રેડશીટ પસંદ કરો"

msgid "Map WooCommerce Fields"
msgstr "WooCommerce ફીલ્ડ્સને નકશો બનાવો"

msgid "Enable Order Sync"
msgstr "ઓર્ડર સમન્વય સક્રિય કરો"

msgid "Upgrade to unlock"
msgstr "અનલોક કરવા માટે અપગ્રેડ કરો"

msgid "Deactivate Integration"
msgstr "એકીકરણ અક્ષમ કરો"

msgid "Are you sure you want to deactivate Google Sheets integration?"
msgstr "શું તમે ખરેખર Google Sheets ઇન્ટિગ્રેશન નિષ્ક્રિય કરવા માંગો છો?"

msgid "Connection Guide"
msgstr "કનેક્શન માર્ગદર્શિકા"

msgid "Step-by-Step"
msgstr "પગલું-દ્વારા-પગલું"

msgid "Follow these steps to connect your Google account and start syncing your form data with Google Sheets."
msgstr "તમારા ગૂગલ એકાઉન્ટને કનેક્ટ કરવા અને તમારા ફોર્મ ડેટાને ગૂગલ શીટ્સ સાથે સમંકલન કરવા માટે આ પગલાં અનુસરો."

msgid "Step-1 Connect Your Google Account"
msgstr "પગલું-1 તમારો ગૂગલ એકાઉન્ટ કનેક્ટ કરો"

msgid "Sign in with your Google account to start the automatic Google Sheets integration."
msgstr "આપમેળે ગૂગલ શીટ્સ ઇન્ટિગ્રેશન શરૂ કરવા માટે તમારા ગૂગલ એકાઉન્ટ સાથે સાઇન ઇન કરો."

msgid "Step-2 Choose Google Account"
msgstr "પગલું-2 ગૂગલ એકાઉન્ટ પસંદ કરો"

msgid "Choose the Google account where your Sheets are stored."
msgstr "તે ગૂગલ એકાઉન્ટ પસંદ કરો જ્યાં તમારી શીટ્સ સંગ્રહિત છે."

msgid "check our detailed guideline"
msgstr "અમારી વિગતવાર માર્ગદર્શિકા તપાસો"

msgid "Step-3 Review Access Information"
msgstr "પગલું-3 ઍક્સેસ માહિતી સમીક્ષા કરો"

msgid "Google will show what information the plugin can access."
msgstr "ગૂગલ બતાવશે કે પ્લગઇન કઈ માહિતી ઍક્સેસ કરી શકે છે."

msgid "Step-4 Grant Required Permissions"
msgstr "પગલું-4 જરૂરી પરવાનગીઓ આપો"

msgid "Allow required permissions for Google Sheets and Drive access."
msgstr "ગૂગલ શીટ્સ અને ડ્રાઈવ ઍક્સેસ માટે જરૂરી પરવાનગીઓ મંજૂર કરો."

msgid "Step-5 Save Authentication Code"
msgstr "પગલું-5 માન્યતા કોડ સાચવો"

msgid "Save the authentication code to complete the Google account connection."
msgstr "ગૂગલ એકાઉન્ટ કનેક્શન પૂર્ણ કરવા માટે માન્યતા કોડ સાચવો."

msgid "Step-6 Integration Completed"
msgstr "પગલું-6 એકીકરણ પૂર્ણ થયું"

msgid "Your Google account is now successfully connected."
msgstr "તમારો Google ખાતો હવે સફળતાપૂર્વક જોડાયો છે."

msgid "Manual Google Sheets Integration"
msgstr "હસ્તચાલિત Google Sheets એકીકરણ"

msgid ""
"Connect WooCommerce to Google Sheets using your own Google Cloud project. Ideal for advanced users who need full API control and "
"custom OAuth setup."
msgstr ""
"તમારા પોતાના Google Cloud પ્રોજેક્ટનો ઉપયોગ કરીને WooCommerce ને Google Sheets સાથે જોડો. સંપૂર્ણ API નિયંત્રણ અને કસ્ટમ OAuth સેટઅપની જરૂરિયાત "
"ધરાવતા અદ્યતન વપરાશકર્તાઓ માટે આદર્શ."

msgid "Custom API Credentials"
msgstr "કસ્ટમ API પ્રમાણપત્રો"

msgid "Connect using your own Google Cloud Client ID and Client Secret for full authentication control."
msgstr "પૂર્ણ પ્રમાણિકતા નિયંત્રણ માટે તમારા પોતાના Google Cloud Client ID અને Client Secret નો ઉપયોગ કરીને જોડાઓ."

msgid "Secure Authentication"
msgstr "સુરક્ષિત પ્રમાણિકતા"

msgid "Authenticate directly with Google using a secure Authentication flow without third-party dependency."
msgstr "ત્રણમૂળ આધાર વિના સુરક્ષિત પ્રમાણિકતા પ્રવાહ સાથે સીધા Google સાથે પ્રમાણિત કરો."

msgid "Advanced Configuration"
msgstr "અદ્યતન કન્ફિગરેશન"

msgid "Set custom Redirect URIs, manage scopes, and configure API settings based on your project needs."
msgstr "તમારા પ્રોજેક્ટની જરૂરિયાતો આધારિત કસ્ટમ રીડાયરેક્ટ URI સેટ કરો, સ્કોપ્સને સંચાલિત કરો, અને API સેટિંગ્સને કન્ફિગર કરો."

msgid "Priority Technical Support"
msgstr "પ્રાથમિક ટેકનિકલ સપોર્ટ"

msgid "Get fast assistance from our expert team for setup, troubleshooting, and optimization."
msgstr "સેટઅપ, સમસ્યાનો ઉકેલ અને ઑપ્ટિમાઇઝેશન માટે અમારી નિષ્ણાત ટીમ પાસેથી ઝડપી સહાય મેળવો."

msgid "Upgrade to Unlock"
msgstr "અનલોક કરવા માટે અપગ્રેડ કરો"

msgid "View Pro Features"
msgstr "પ્રો ફીચર્સ જુઓ"

msgid "Service Account Google Sheets Integration"
msgstr "સેવા ખાતા Google Sheets એકીકરણ"

msgid "Connect WooCommerce to Google Sheets using a Service Account for automated syncing without manual login."
msgstr "મેન્યુઅલ લૉગિન વિના સ્વચાલિત સમન્વય માટે સેવા ખાતાનો ઉપયોગ કરીને WooCommerce ને Google Sheets સાથે જોડો."

msgid "Secure JSON Authentication"
msgstr "સુરક્ષિત JSON પ્રમાણિકતા"

msgid "Authenticate using a secure Google Cloud JSON key file for direct and encrypted communication with Google Sheets."
msgstr "Google Sheets સાથે સીધી અને એન્ક્રિપ્ટેડ સંવાદ માટે સુરક્ષિત Google Cloud JSON કી ફાઇલનો ઉપયોગ કરીને પ્રમાણિત કરો."

msgid "No Authentication Login Required"
msgstr "કોઈ પ્રમાણિકતા લોગિનની જરૂર નથી"

msgid "Enable automatic background syncing without requiring Google account sign-in during setup."
msgstr "સેટઅપ દરમિયાન Google ખાતા સાઇન-ઇનની જરૂર વગર સ્વચાલિત પૃષ્ઠભૂમિ સમન્વય સક્રિય કરો."

msgid "Direct Spreadsheet Access"
msgstr "સિધા સ્પ્રેડશીટ ઍક્સેસ"

msgid "Share your Google Sheet with the service account email to enable automatic data transfer."
msgstr "તમારા Google Sheet ને સેવા ખાતા ઈમેઇલ સાથે શેર કરો જેથી આપોઆપ ડેટા ટ્રાન્સફર સક્રિય થાય."

msgid "Production-Ready & Reliable"
msgstr "ઉત્પાદન-તૈયાર અને વિશ્વસનીય"

msgid "Built for stable, uninterrupted syncing in professional and high-traffic environments."
msgstr "વ્યવસાયિક અને ઉચ્ચ ટ્રાફિક પર્યાવરણમાં સ્થિર, અવિરત સમન્વય માટે બનાવવામાં આવ્યું."

msgid "Permission Not Allowed"
msgstr "પરવાનગી મંજૂર નથી"

msgid "Unlock Role-Based Access Control"
msgstr "રોલ આધારિત ઍક્સેસ નિયંત્રણ અનલોક કરો"

msgid "Advanced options are available in PRO"
msgstr "અદ્યતન વિકલ્પો PRO માં ઉપલબ્ધ છે"

msgid "Role Permissions"
msgstr "રોલ પરવાનગીઓ"

msgid "Allow specific WordPress roles"
msgstr "વિશિષ્ટ WordPress રોલને મંજૂરી આપો"

msgid "Enable/disable integration access"
msgstr "એકીકરણ ઍક્સેસ સક્રિય/નિષ્ક્રિય કરો"

msgid "Control WooCommerce sync visibility"
msgstr "WooCommerce સમન્વય દૃશ્યતા નિયંત્રિત કરો"

msgid "Restrict settings management"
msgstr "સેટિંગ્સ મેનેજમેન્ટને પ્રતિબંધિત કરો"

msgid "Security Control"
msgstr "સુરક્ષા નિયંત્રણ"

msgid "Prevent unauthorized changes"
msgstr "અધિકૃત ફેરફારોને રોકો"

msgid "Secure Google Sheet credentials"
msgstr "ગૂગલ શીટના પ્રમાણપત્રોને સુરક્ષિત કરો"

msgid "Role-based configuration control"
msgstr "ભૂમિકા આધારિત કન્ફિગરેશન નિયંત્રણ"

msgid "Protect integration settings"
msgstr "ઇન્ટિગ્રેશન સેટિંગ્સને સુરક્ષિત કરો"

msgid "Management Benefits"
msgstr "મેનેજમેન્ટ ફાયદા"

msgid "Grant access to trusted editors"
msgstr "વિશ્વસનીય સંપાદકોને ઍક્સેસ આપો"

msgid "Hide settings from subscribers"
msgstr "સબ્સ્ક્રાઇબર્સથી સેટિંગ્સ છુપાવો"


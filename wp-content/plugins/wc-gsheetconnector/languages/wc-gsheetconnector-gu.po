msgstr "Google Sheets Tab Names નું અનુવાદ કરો"

msgid "This setting displays tab names according to your WordPress site language."
msgstr "આ સેટિંગ તમારા WordPress સાઇટની ભાષા અનુસાર ટેબ નામો દર્શાવે છે."

msgid "Enable Language Translation"
msgstr "ભાષા અનુવાદ સક્રિય કરો"

msgid "When enabled, Google Sheet tab names will be displayed in the language selected for your WordPress site."
msgstr "સક્રિય કર્યા પછી, Google Sheet tab names તમારી WordPress સાઇટ માટે પસંદ કરેલી ભાષામાં દર્શાવવામાં આવશે."

msgid "Headers"
msgstr "હેડર્સ"

msgid "Custom order statuses will appear here. Turn them on to create a new tab for each in your Google Sheet."
msgstr "કસ્ટમ ઓર્ડર સ્થિતિઓ અહીં દેખાશે. તમારા Google Sheet માં દરેક માટે નવી ટેબ બનાવવા માટે તેમને સક્રિય કરો."

msgid "No custom order statuses are currently available."
msgstr "કોઈ કસ્ટમ ઓર્ડર સ્થિતિ હાલમાં ઉપલબ્ધ નથી."

msgid ""
"Enable additional Sheet tabs to sync more WooCommerce information to your Google Sheet. Each selected option will create and "
"update its own tab automatically."
msgstr ""
"તમારા Google Sheet માં વધુ WooCommerce માહિતી સમન્વયિત કરવા માટે વધારાના શીટ ટેબ સક્રિય કરો. દરેક પસંદ કરેલ વિકલ્પ આપોઆપ તેની própria ટેબ "
"બનાવશે અને અપડેટ કરશે."

msgid "All Products"
msgstr "બધા ઉત્પાદનો"

msgid "All Products Variation"
msgstr "બધા ઉત્પાદનોના ફેરફાર"

msgid "All Customers"
msgstr "બધા ગ્રાહકો"

msgid "All Coupons"
msgstr "બધા કૂપન"

msgid "All Subscriptions"
msgstr "બધા સબ્સ્ક્રિપ્શન"

msgid "Choose how orders should appear in your Google Sheet:"
msgstr "તમારા Google Sheet માં ઓર્ડર કેવી રીતે દેખાવા જોઈએ તે પસંદ કરો:"

msgid "Order Wise :"
msgstr "ઓર્ડર મુજબ :"

msgid "Each order is added as a single row, even if it contains multiple products."
msgstr "દરેક ઓર્ડર એક જ પંક્તિ તરીકે ઉમેરવામાં આવે છે, ભલે તેમાં અનેક ઉત્પાદનો હોય."

msgid "Product Wise :"
msgstr "ઉત્પાદન મુજબ :"

msgid "Each product in an order is added as a separate row, so you can see details for every item."
msgstr "એક ઓર્ડરમાં દરેક ઉત્પાદન અલગ પંક્તિ તરીકે ઉમેરવામાં આવે છે, જેથી તમે દરેક વસ્તુની વિગતો જોઈ શકો."

msgid ""
"You can also choose how the entries are sorted (ascending or descending). Your selected format and sorting will be applied across "
"all tabs in the sheet."
msgstr ""
"તમે એન્ટ્રીઓ કેવી રીતે સોર્ટ કરવી તે પણ પસંદ કરી શકો છો (ઉપરથી નીચે અથવા નીચેથી ઉપર). તમારું પસંદ કરેલું ફોર્મેટ અને સોર્ટિંગ શીટના તમામ ટેબ્સમાં લાગુ "
"કરવામાં આવશે."

msgid "Select Sync Format"
msgstr "સિંક ફોર્મેટ પસંદ કરો"

msgid "Order Wise"
msgstr "ઓર્ડર મુજબ"

msgid "Product Wise"
msgstr "ઉત્પાદન મુજબ"

msgid "Sorting"
msgstr "સોર્ટિંગ"

msgid "Ascending"
msgstr "ઉપરવાળા"

msgid "Descending"
msgstr "નીચેવાળા"

msgid "Order Category Filter"
msgstr "ઓર્ડર શ્રેણી ફિલ્ટર"

msgid ""
"Filter orders by category before syncing to your Google Sheet. When enabled, only selected categories will be synced. When "
"disabled, all orders will be included. This applies to adding, updating, and syncing orders."
msgstr ""
"તમારા Google Sheet પર સિંક કરવા માટે શ્રેણી મુજબ ઓર્ડરોને ફિલ્ટર કરો. જ્યારે સક્રિય હોય, ત્યારે ફક્ત પસંદ કરેલ શ્રેણીઓ જ સિંક કરવામાં આવશે. જ્યારે "
"નિષ્ક્રિય હોય, ત્યારે તમામ ઓર્ડરો સામેલ કરવામાં આવશે. આ ઉમેરવા, અપડેટ કરવા અને ઓર્ડરોને સિંક કરવા માટે લાગુ થાય છે."

msgid "Select Category"
msgstr "શ્રેણી પસંદ કરો"

msgid "Product Category Filter"
msgstr "ઉત્પાદન શ્રેણી ફિલ્ટર"

msgid ""
"Filter products by category before syncing to your Google Sheet. When enabled, only selected categories will be synced. When "
"disabled, all products will be included. This applies to adding, updating, and syncing products."
msgstr ""
"તમારા Google Sheet પર સિંક કરવા માટે ઉત્પાદનોને શ્રેણી મુજબ ફિલ્ટર કરો. જ્યારે સક્રિય હોય, ત્યારે ફક્ત પસંદ કરેલ શ્રેણીઓ જ સિંક કરવામાં આવશે. જ્યારે "
"નિષ્ક્રિય હોય, ત્યારે તમામ ઉત્પાદનો સામેલ કરવામાં આવશે. આ ઉમેરવા, અપડેટ કરવા અને ઉત્પાદનોને સિંક કરવા માટે લાગુ થાય છે."

msgid ""
"Sync data between WooCommerce and Google Sheets in real-time. Enable this feature to manage orders, products, and more directly "
"from your spreadsheet."
msgstr ""
"વૂકોમર્સ અને Google Sheets વચ્ચે રિયલ-ટાઇમમાં ડેટા સિંક કરો. આ ફીચર સક્રિય કરો જેથી તમે તમારા સ્પ્રેડશીટમાંથી સીધા ઓર્ડરો, ઉત્પાદનો અને વધુને સંચાલિત "
"કરી શકો."

msgid "Enable 2-Way Sync"
msgstr "2-માર્ગી સિંક સક્રિય કરો"

msgid "Allow Google Sheets to update WooCommerce data."
msgstr "Google Sheets ને વૂકોમર્સ ડેટા અપડેટ કરવાની મંજૂરી આપો."


# ==============================================================================
# SAMI-webshop Environment Configuration Template
# Copy this file to .env and adjust values for your server environment.
# Command: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# In Docker Compose mode, DB_HOST should remain 'db'.
# In Native LAMP/LEMP mode, DB_HOST is usually 'localhost' or '127.0.0.1'.
DB_NAME=sami_webshop
DB_USER=sami_user
DB_PASSWORD=change_this_to_a_secure_password
DB_ROOT_PASSWORD=change_this_to_a_secure_root_password
DB_HOST=db
DB_PORT=3306
DB_PREFIX=wp_
DB_CHARSET=utf8mb4
DB_COLLATE=

# ------------------------------------------------------------------------------
# Site Domain & URLs
# ------------------------------------------------------------------------------
# Specify full URL including protocol (https:// or http://) and no trailing slash.
# Examples:
#   Production: https://84kitchen-kempten.de
#   Staging:    https://staging.84kitchen-kempten.de
#   Local/Dev:  http://localhost:8080 or https://sami-webshop.ddev.site
WP_HOME=http://localhost
WP_SITEURL=http://localhost

# ------------------------------------------------------------------------------
# Server & Docker Port Mapping
# ------------------------------------------------------------------------------
# Ports bound on the host machine in Docker Compose mode.
HTTP_PORT=80
HTTPS_PORT=443
PMA_PORT=8080

# ------------------------------------------------------------------------------
# Environment & Debugging
# ------------------------------------------------------------------------------
# Possible values: 'production', 'staging', 'development', 'local'
WP_ENVIRONMENT_TYPE=production
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
SCRIPT_DEBUG=false

# ------------------------------------------------------------------------------
# Memory & Upload Limits
# ------------------------------------------------------------------------------
WP_MEMORY_LIMIT=512M
WP_MAX_MEMORY_LIMIT=512M

# ------------------------------------------------------------------------------
# WordPress Authentication Unique Keys and Salts
# ------------------------------------------------------------------------------
# You can generate fresh keys at: https://api.wordpress.org/secret-key/1.1/salt/
# Or run: ./scripts/deploy.sh --generate-salts
AUTH_KEY=put_your_unique_phrase_here_1
SECURE_AUTH_KEY=put_your_unique_phrase_here_2
LOGGED_IN_KEY=put_your_unique_phrase_here_3
NONCE_KEY=put_your_unique_phrase_here_4
AUTH_SALT=put_your_unique_phrase_here_5
SECURE_AUTH_SALT=put_your_unique_phrase_here_6
LOGGED_IN_SALT=put_your_unique_phrase_here_7
NONCE_SALT=put_your_unique_phrase_here_8

